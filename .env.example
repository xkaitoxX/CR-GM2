# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.
# The README's "Setting it up" section explains each one step by step.

# --- Required ---

# Your key from https://console.anthropic.com (Settings → API keys). It pays for the AI agents.
ANTHROPIC_API_KEY=

# Any password you choose. The website asks for it before showing messages or using the AI.
APP_PASSWORD=

# Your website's address, used for ticket links in emails. Example: https://seller-assistant.vercel.app
APP_URL=

# --- Optional ---

# The AI model. Leave empty for Claude Haiku 5.5 (the cheapest). Example of a stronger one: claude-sonnet-5-5
AI_MODEL=

# The name customer replies are signed with. Leave empty for "Customer Service".
SHOP_NAME=

# --- Database (Supabase). Without it, tickets and messages are lost when the website restarts. ---

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → secret key (or the older service_role key). Keep it private.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email. Needed for reading Amazon buyer messages and replying automatically. ---

# The shop's email address and its app password (not the normal password).
EMAIL_USER=
EMAIL_PASSWORD=
# Where ticket alerts go, e.g. your personal email.
OWNER_EMAIL=
# Only for providers other than Gmail, iCloud and Yahoo:
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=

# --- Scheduled email checks ---

# A long random password. Vercel Cron and cron-job.org send it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
